# Vault service — copy into repo-root `.env`
# See README.md in this folder.

JWT_PUBLIC_KEY=
VAULT_SERVICE_API_KEY=local-dev-vault-key
VAULT_PUBLIC_BASE_URL=http://127.0.0.1:8003
VAULT_STORAGE_ROOT=/tmp/trawellcare-vault
VAULT_MAX_UPLOAD_BYTES=20971520
PLATFORM_BASE_URL=http://127.0.0.1:8001
PLATFORM_CASE_CHECK_ENABLED=true
