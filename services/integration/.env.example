# Integration service — copy these into the repo-root `.env` file.
# See README.md in this folder.

INTEGRATION_API_KEY=

# --- Email: Mailpit (browser UI at http://localhost:8025) ---
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USE_TLS=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@trawellcare.local

# --- Email: SendGrid SMTP (production) — replace Mailpit block with: ---
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USE_TLS=true
# SMTP_USER=apikey
# SENDGRID_API_KEY=
# EMAIL_FROM=hello@your-verified-sendgrid-domain.com

# --- Akbar Travels (Benzy B2B flight) ---
VENDOR_AKBAR_FLIGHT_BASE_URL=https://b2bapiflights.benzyinfotech.com
VENDOR_AKBAR_UTILS_BASE_URL=https://b2bapiutils.benzyinfotech.com
VENDOR_AKBAR_MERCHANT_ID=
VENDOR_AKBAR_CLIENT_ID=
VENDOR_AKBAR_AGENT_CODE=
VENDOR_AKBAR_CHANNEL_ID=
VENDOR_AKBAR_API_KEY=
VENDOR_AKBAR_PASSWORD=
VENDOR_AKBAR_BROWSER_KEY=
VENDOR_AKBAR_KEY=
